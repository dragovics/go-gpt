@echo off
title Setup ChatGPT Relay Windows (Port 20250)
echo =====================================================================
echo    CHATGPT WEB RELAY & TOOL CALLING - ALL-IN-ONE SETUP WINDOWS
echo =====================================================================
echo.

where python >nul 2>nul
if %errorlevel% neq 0 (
    echo [ERROR] Python tidak terdeteksi di PATH Windows!
    echo Silakan install Python dari https://www.python.org/downloads/
    echo Pastikan centang "Add python.exe to PATH" saat installasi.
    echo.
    pause
    exit /b 1
)

set TARGET_DIR=%USERPROFILE%\chatgpt-relay
echo [*] Membuat folder di: %TARGET_DIR%
if not exist "%TARGET_DIR%" mkdir "%TARGET_DIR%"
cd /d "%TARGET_DIR%"

echo [*] Menyiapkan Python Virtual Environment (venv)...
if not exist "venv\Scripts\python.exe" (
    python -m venv venv
)

echo [*] Menginstall library (fastapi, uvicorn, websockets, httpx)...
venv\Scripts\python.exe -m pip install --upgrade pip -q
venv\Scripts\pip.exe install -q fastapi uvicorn websockets httpx

echo [*] Menulis file chatgpt_relay_server.py...
(
python -c "import base64; print(base64.b64decode('').decode('utf-8'))"
) > chatgpt_relay_server.py

echo [*] Menulis file cdp_relay_driver.py...
(
python -c "import base64; print(base64.b64decode('').decode('utf-8'))"
) > cdp_relay_driver.py

echo [*] Menulis start_chrome.bat...
(
echo @echo off
echo title Chrome CDP for ChatGPT
echo set CHROME_EXE=""
echo if exist "C:\Program Files\Google\Chrome\Application\chrome.exe" set CHROME_EXE="C:\Program Files\Google\Chrome\Application\chrome.exe"
echo if exist "C:\Program Files (x86)\Google\Chrome\Application\chrome.exe" set CHROME_EXE="C:\Program Files (x86)\Google\Chrome\Application\chrome.exe"
echo if exist "%%LOCALAPPDATA%%\Google\Chrome\Application\chrome.exe" set CHROME_EXE="%%LOCALAPPDATA%%\Google\Chrome\Application\chrome.exe"
echo if %%CHROME_EXE%%=="" (
echo     echo [ERROR] Google Chrome tidak ditemukan!
echo     pause
echo     exit /b 1
echo ^)
echo start "" %%CHROME_EXE%% --remote-debugging-port=9222 --user-data-dir="%%LOCALAPPDATA%%\Google\Chrome\RelayProfile" --remote-allow-origins=* --no-first-run --no-default-browser-check https://chatgpt.com/
echo [OK] Chrome berjalan. Silakan LOGIN ke akun ChatGPT di jendela browser yang terbuka!
) > start_chrome.bat

echo [*] Menulis start_relay.bat...
(
echo @echo off
echo title ChatGPT Relay (:20250)
echo cd /d "%%~dp0"
echo start "ChatGPT Server (:20250)" venv\Scripts\python.exe chatgpt_relay_server.py
echo timeout /t 2 /nobreak ^>nul
echo start "ChatGPT CDP Driver" venv\Scripts\python.exe cdp_relay_driver.py
echo [OK] Relay aktif di http://127.0.0.1:20250
echo Cek status: http://127.0.0.1:20250/status
) > start_relay.bat

echo.
echo =====================================================================
echo  [SUKSES] INSTALASI SELESAI!
echo =====================================================================
echo Lokasi folder: %TARGET_DIR%
echo.
echo LANGKAH MENJALANKAN:
echo 1. Jalankan "%TARGET_DIR%\start_chrome.bat" lalu LOGIN ke chatgpt.com
echo 2. Jalankan "%TARGET_DIR%\start_relay.bat" untuk mengaktifkan Relay
echo.
echo Di VSCode (Cline / Roo Code / Continue):
echo - Provider : OpenAI Compatible
echo - Base URL : http://localhost:20250/v1
echo - API Key  : dummy
echo - Model    : chatgpt-web
echo =====================================================================
echo.
pause
